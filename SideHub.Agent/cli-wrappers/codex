#!/usr/bin/env bash
# SideHub wrapper around `codex`.
#
# Why this exists: SideHub reads a run's token usage from the CLI's own session
# files. Unlike claude (see ./claude), codex doesn't accept a pre-set session id,
# so SideHub cannot know which ~/.codex/sessions/**/rollout-*.jsonl belongs to a
# run. This wrapper tells the agent when, in which directory and as which
# process codex starts (through the FIFO at $SIDEHUB_PTY_NOTIFY_FIFO); the
# agent then finds the rollout the process holds open (or, failing that,
# matches it by cwd + start time).
#
# Failure modes: the notification is best-effort. If the FIFO write fails we
# still launch codex; if the real codex can't be found we exit like a shell would.

# Locate the real `codex` binary, skipping our own wrapper dir.
self_dir="$(cd "$(dirname "$0")" && pwd -P)"
self="$self_dir/$(basename "$0")"
real=""
IFS=':' read -ra _paths <<< "$PATH"
for _p in "${_paths[@]}"; do
  # Only absolute entries: empty and relative ones resolve against the current
  # directory (a repository), where a committed ./codex would run instead.
  case "$_p" in /*) ;; *) continue ;; esac
  # Compared by file identity, not text: a link to this folder, a trailing
  # slash or another path to this wrapper would otherwise make it exec itself.
  if [ "$_p" -ef "$self_dir" ]; then continue; fi
  candidate="$_p/codex"
  if [ "$candidate" -ef "$self" ]; then continue; fi
  if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
    real="$candidate"
    break
  fi
done

if [ -z "$real" ]; then
  echo "sidehub: real 'codex' not found in PATH" >&2
  exit 127
fi

# Physical path, as codex records it in the rollout's session_meta.cwd.
# $$ is codex's own pid once we exec it below.
if [ -n "$SIDEHUB_PTY_NOTIFY_FIFO" ] && [ -p "$SIDEHUB_PTY_NOTIFY_FIFO" ]; then
  _cwd="$(pwd -P 2>/dev/null)"
  _cwd="${_cwd//\\/\\\\}"
  _cwd="${_cwd//\"/\\\"}"
  ( printf '{"event":"cli-launched","provider":"codex","cwd":"%s","pid":%d}\n' "$_cwd" "$$" > "$SIDEHUB_PTY_NOTIFY_FIFO" ) >/dev/null 2>&1 &
fi

exec "$real" "$@"
