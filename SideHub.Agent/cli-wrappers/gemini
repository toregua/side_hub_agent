#!/usr/bin/env bash
# SideHub wrapper around a coding CLI. The same file is installed as `claude`, `codex`, `gemini` and
# `copilot`; it acts for the name it was called by.
#
# Why this exists: when a user types `claude` (or codex, gemini, copilot) in a SideHub shell, SideHub
# must know which CLI session runs in the terminal, to resume it later and read its token usage.
# `sidehub-cli launch`, shipped next to the agent, does that on every OS: it pre-sets the session id
# when the CLI accepts one (`--session-id`), tells the agent through the FIFO at
# $SIDEHUB_PTY_NOTIFY_FIFO, then runs the real CLI. This wrapper only hands over to it.
#
# Failure modes: without the launcher (older install), the real CLI runs directly, as if there were
# no wrapper; if it can't be found either, we exit like a shell would.

cli="$(basename "$0")"
self_dir="$(cd "$(dirname "$0")" && pwd -P)"

launcher="$(dirname "$self_dir")/sidehub-cli"
if [ -x "$launcher" ]; then
  exec "$launcher" launch "$cli" "$@"
fi

# Locate the real binary, skipping our own wrapper dir.
self="$self_dir/$(basename "$0")"
real=""
IFS=':' read -ra _paths <<< "$PATH"
for _p in "${_paths[@]}"; do
  # Only absolute entries: empty and relative ones resolve against the current
  # directory (a repository), where a committed ./claude would run instead.
  case "$_p" in /*) ;; *) continue ;; esac
  # Compared by file identity, not text: a link to this folder, a trailing
  # slash or another path to this wrapper would otherwise make it exec itself.
  if [ "$_p" -ef "$self_dir" ]; then continue; fi
  candidate="$_p/$cli"
  if [ "$candidate" -ef "$self" ]; then continue; fi
  if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
    real="$candidate"
    break
  fi
done

if [ -z "$real" ]; then
  echo "sidehub: real '$cli' not found in PATH" >&2
  exit 127
fi

exec "$real" "$@"
