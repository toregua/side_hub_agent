<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sidehub-agent</AssemblyName>
    <!-- Overridden by the release pipeline from the git tag (-p:Version=1.0.x); local builds report 0.0.0-dev. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!-- Include pty-helper Node.js files. node_modules is installed from the lockfile with npm ci
       (production deps, no install scripts): bundled in the release archive by the CI, or by install-local.sh. -->
  <ItemGroup>
    <None Include="pty-helper\index.js" CopyToOutputDirectory="PreserveNewest" Link="pty-helper\index.js" />
    <None Include="pty-helper\package.json" CopyToOutputDirectory="PreserveNewest" Link="pty-helper\package.json" />
    <None Include="pty-helper\package-lock.json" CopyToOutputDirectory="PreserveNewest" Link="pty-helper\package-lock.json" />
  </ItemGroup>

  <!-- CLI wrappers prepended to PATH inside each PTY shell so that `claude` etc.
       resolve to our script first. The script injects a SideHub-minted session id
       and notifies the agent via FIFO. See WebSocketClient.BuildTerminalEnvironment. -->
  <ItemGroup>
    <None Include="cli-wrappers\claude" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\claude" />
    <None Include="cli-wrappers\codex" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\codex" />
    <None Include="cli-wrappers\gemini" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\gemini" />
    <None Include="cli-wrappers\copilot" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\copilot" />
    <None Include="cli-wrappers\sidehub.bashrc" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\sidehub.bashrc" />
  </ItemGroup>

</Project>
