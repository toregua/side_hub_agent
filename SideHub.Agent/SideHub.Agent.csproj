<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sidehub-agent</AssemblyName>
  </PropertyGroup>

  <!-- Include pty-helper Node.js files (node_modules must be installed separately via npm install) -->
  <ItemGroup>
    <None Include="pty-helper\index.js" CopyToOutputDirectory="PreserveNewest" Link="pty-helper\index.js" />
    <None Include="pty-helper\package.json" CopyToOutputDirectory="PreserveNewest" Link="pty-helper\package.json" />
  </ItemGroup>

  <!-- CLI wrappers prepended to PATH inside each PTY shell so that `claude` etc.
       resolve to our script first. The script injects a SideHub-minted session id
       and notifies the agent via FIFO. See WebSocketClient.BuildTerminalEnvironment. -->
  <ItemGroup>
    <None Include="cli-wrappers\claude" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\claude" />
    <None Include="cli-wrappers\sidehub.bashrc" CopyToOutputDirectory="PreserveNewest" Link="cli-wrappers\sidehub.bashrc" />
  </ItemGroup>

</Project>
