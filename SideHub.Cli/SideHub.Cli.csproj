<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sidehub-cli</AssemblyName>
    <!-- No libicu needed: minimal Linux images (Alpine, distroless, slim containers) lack it and the runtime would
         abort at startup. Everything culture-sensitive here formats with the invariant culture anyway. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SideHub.Agent.Tests" />
  </ItemGroup>

</Project>
